\uc804\ud558\ub294 \uacfc\uc815\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc54c\uace0 \uc788\ub294 \ubc29\ubc95\uc744 \uc2e4\uc81c \uc774\ud574\ub85c \uc5f0\uacb0\ud558\ub294 \ubd80\ubd84\uc5d0\uc11c \uc870\uae08 \ub354 \ud6c8\ub828\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ub3c5\uc11c \uacbd\ud5d8\uc744 \ud1b5\ud574 \uafb8\uc900\ud788 \uc131\uc7a5\ud560 \uc218 \uc788\uc73c\uba70, \ubc30\uc6b4 \uc804\ub7b5\uc744 \uc2e4\ucc9c\uc73c\ub85c \uc62e\uae38 \ub54c \ub354 \ud070 \uc131\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ucc45\uc744 \uc88b\uc544\ud558\uace0 \ub2e4\uc591\ud55c \ud14d\uc2a4\ud2b8\uc5d0 \ub178\ucd9c\ub418\uc5b4 \ud48d\ubd80\ud55c \ub3c5\uc11c \uacbd\ud5d8\uc744 \uc313\uace0 \uc788\uc9c0\ub9cc, \uc774\ud574\ub85c \uc5f0\uacb0\ub418\uc9c0 \ubabb\ud558\ub294 \uacbd\uc6b0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ucde8\ubbf8 \ub3c5\uc11c\uc5d0 \uce58\uc911\ud558\uac70\ub098 \uc790\uae30 \uc8fc\uc7a5\uc774 \uac15\ud55c \ud3b8\uc77c \uc218 \uc788\uc73c\ubbc0\ub85c, \ud559\uc2b5 \ub9e5\ub77d\uc5d0\uc11c \uc804\ub7b5\uc744 \uc2e4\uc81c\ub85c \uc801\uc6a9\ud558\ub294 \ud6c8\ub828\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.",url:"assets/images/prsv2/step/new_step7.svg"};case 8:return{name:"\ud3c9\uade0 \uc131\uc2e4\ud615",newName:"\ubb35\ubb35\ud788 \uac77\ub294 \uc131\uc2e4\ud30c",desc:"\uafb8\uc900\ud788 \ud559\uc2b5\uc744 \uc774\uc5b4\uac00\uba70 \ud3c9\uade0\uc801\uc778 \uc131\uacfc\ub97c \ubcf4\uc774\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc131\uc2e4\ud55c \ud0dc\ub3c4\ub97c \ubc14\ud0d5\uc73c\ub85c \uae30\ubcf8\uae30\ub97c \uc798 \uc720\uc9c0\ud558\uace0 \uc788\uc73c\uba70, \uc77c\uc815\ud55c \ud559\uc2b5 \ud328\ud134\uc744 \uac16\ucd94\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub3c5\uc11c\uc640 \ud559\uc2b5\uc5d0 \ud765\ubbf8\ub97c \uc870\uae08 \ub354\ud55c\ub2e4\uba74 \ud604\uc7ac\ubcf4\ub2e4 \ud55c \ub2e8\uacc4 \ub192\uc740 \uc131\ucde8\ub97c \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",advancedDesc:"\uafb8\uc900\ud788 \ud559\uc2b5\uc744 \uc774\uc5b4\uac00\uba70 \ud3c9\uade0\uc801\uc778 \uc131\uacfc\ub97c \ubcf4\uc774\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc131\uc2e4\ud55c \ud0dc\ub3c4\ub97c \ubc14\ud0d5\uc73c\ub85c \uae30\ubcf8\uae30\ub97c \uc798 \uc720\uc9c0\ud558\uace0 \uc788\uc73c\uba70, \uc77c\uc815\ud55c \ud559\uc2b5 \ud328\ud134\uc744 \uac16\ucd94\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub3c5\uc11c\uc640 \ud559\uc2b5\uc5d0 \ud765\ubbf8\ub97c \uc870\uae08 \ub354\ud55c\ub2e4\uba74 \ud604\uc7ac\ubcf4\ub2e4 \ud55c \ub2e8\uacc4 \ub192\uc740 \uc131\ucde8\ub97c \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uaddc\uce59\uc801\uc73c\ub85c \ud559\uc2b5\uc740 \ud558\uc9c0\ub9cc \ub0b4\uc801 \ub3d9\uae30\uac00 \ubd80\uc871\ud574 \uc758\ubb34\uc801\uc73c\ub85c \uc774\uc5b4\uac00\ub294 \uacbd\uc6b0\uac00 \uc788\uc73c\uba70, \ub2e8\uc21c \uc694\uc57d \uc911\uc2ec\uc758 \uc77d\uae30\uac00 \ub9ce\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc791\uc740 \uc131\ucde8 \uacbd\ud5d8\uc774 \ub3d9\uae30 \ubd80\uc5ec\uac00 \ub41c\ub2e4\uba74, \uc131\uc2e4\ud568\uc774 \uac15\uc810\uc73c\ub85c \uc791\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",url:"assets/images/prsv2/step/new_step8.svg"};case 7:return{name:"\ud5a5\uc0c1 \ud544\uc694\ud615",newName:"\ub2e4\ub4ec\uc5b4\uc9c0\uc9c0 \uc54a\uc740 \uc6d0\uc11d",desc:"\ud604\uc7ac\ub294 \ud3c9\uade0\uc801\uc778 \uc774\ud574\ub3c4\uc640 \uc131\uacfc\ub97c \ubcf4\uc774\uace0 \uc788\uc9c0\ub9cc, \ub178\ub825\ud558\uba74 \ucda9\ubd84\ud788 \uc131\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccb4\uacc4\uc801\uc778 \ud6c8\ub828\uc744 \ud1b5\ud574, \ub3c5\uc11c \uc2b5\uad00\uc744 \ud615\uc131\ud574 \ub098\uac00\uba74 \uc131\uacfc\uac00 \ud55c\uce35 \ub192\uc544\uc9c8 \uac83\uc785\ub2c8\ub2e4. \uc7a0\uc7ac\ub825\uc774 \uc788\uae30 \ub54c\ubb38\uc5d0 \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc791\uc740 \uc131\ucde8\uac00 \ud070 \ubcc0\ud654\ub97c \uc774\ub04c\uc5b4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4.",advancedDesc:"\ud604\uc7ac\ub294 \ud3c9\uade0\uc801\uc778 \uc774\ud574\ub3c4\uc640 \uc131\uacfc\ub97c \ubcf4\uc774\uace0 \uc788\uc9c0\ub9cc, \ub178\ub825\ud558\uba74 \ucda9\ubd84\ud788 \uc131\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccb4\uacc4\uc801\uc778 \ud6c8\ub828\uc744 \ud1b5\ud574, \ub3c5\uc11c\uc2b5\uad00\uc744 \ud615\uc131\ud574 \ub098\uac00\uba74 \uc131\uacfc\uac00 \ud55c\uce35 \ub192\uc544\uc9c8 \uac83\uc785\ub2c8\ub2e4. \uc7a0\uc7ac\ub825\uc774 \uc788\uae30 \ub54c\ubb38\uc5d0 \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc791\uc740 \uc131\ucde8\uac00 \ud070 \ubcc0\ud654\ub97c \uc774\ub04c\uc5b4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ud559\uc2b5 \uc18d\ub3c4\uac00 \ub2e4\uc18c \ub354\ub51c \uc218 \uc788\uace0, \uc8fc\ubcc0\uc758 \uae30\ub300\uac00 \ubd80\ub2f4\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc791\uc740 \uc131\uacf5\uc744 \uacbd\ud5d8\ud558\ub3c4\ub85d \ub3d5\ub294\ub2e4\uba74, \uc2a4\uc2a4\ub85c \uc790\uc2e0\uac10\uc744 \uc313\uc544\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",url:"assets/images/prsv2/step/new_step9.svg"};case 6:return{name:"\uc804\ub7b5 \ubd88\uade0\ud615\ud615",newName:"\ub0b4\uc2e4\uc774 \ud544\uc694\ud55c \ud65c\ub3d9\uac00",desc:"\ub3c5\uc11c \uc804\ub7b5\uc744 \uc54c\uace0 \uc788\uc9c0\ub9cc \uc2e4\uc81c \uc774\ud574\ub85c \uc5f0\uacb0\ud558\ub294 \uacfc\uc815\uc774 \ub354 \ud544\uc694\ud569\ub2c8\ub2e4. \uae00\uc758 \uc758\ubbf8\ub97c \uae4a\uac8c \ud30c\uc545\ud558\ub294 \ud6c8\ub828\uc744 \ud1b5\ud574 \ud559\uc2b5\uc758 \ud6a8\uacfc\uac00 \ub192\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\ubc95\uc744 \ub2e4\ub4ec\uace0 \uc774\ud574\ub825\uc744 \ud568\uaed8 \ud0a4\uc6b0\uba74 \uade0\ud615 \uc788\ub294 \uc131\uc7a5\uc744 \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",advancedDesc:"\uc790\ubc1c\uc801 \ub3c5\uc11c\ub97c \ud558\ub294 \uac83\ucc98\ub7fc \ubcf4\uc774\ub098 \uc2e4\uc81c \uc774\ud574\ub85c \uc5f0\uacb0\ud558\ub294 \uacfc\uc815\uc774 \ub354 \ud544\uc694\ud569\ub2c8\ub2e4. \uae00\uc758 \uc758\ubbf8\ub97c \uae4a\uac8c \ud30c\uc545\ud558\ub294 \ud6c8\ub828\uc744 \ud1b5\ud574 \ud559\uc2b5\uc758 \ud6a8\uacfc\uac00 \ub192\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\ubc95\uc744 \ub2e4\ub4ec\uace0 \uc774\ud574\ub825\uc744 \ud568\uaed8 \ud0a4\uc6b0\uba74 \uade0\ud615 \uc788\ub294 \uc131\uc7a5\uc744 \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uac74\uc131\uc73c\ub85c \uc77d\ub294 \uc2b5\uad00\uc774\ub098 \uc9c0\uc2dd\uc758 \uc595\uc74c\uc774 \ub4dc\ub7ec\ub098\uae30\ub3c4 \ud558\uba70, \ud2b9\ud788 \ube44\ubb38\ud559 \uc7a5\ub974\uc5d0\uc11c \uc57d\uc810\uc744 \ubcf4\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \ud65c\ubc1c\ud55c \uc131\ud5a5\uc744 \ud1a0\ub860\uc774\ub098 \ud611\ub825 \ud559\uc2b5\uc5d0 \ud65c\uc6a9\ud558\uba74 \uc7a5\uc810\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",url:"assets/images/prsv2/step/new_step10.svg"};case 5:return{name:"\ub3d9\uae30 \ubd80\uc871\ud615",newName:"\uc7a0\uc7ac\ub825\ub9cc \ubbff\ub294 \ubca0\uc9f1\uc774",desc:"\uae30\ubcf8\uc801\uc778 \ub3c5\uc11c \ub2a5\ub825\uc740 \uac16\ucd94\uace0 \uc788\uc9c0\ub9cc, \ud765\ubbf8\uc640 \ub3d9\uae30\uac00 \ubd80\uc871\ud55c \ud3b8\uc785\ub2c8\ub2e4. \uad00\uc2ec\uc744 \ub04c \uc218 \uc788\ub294 \ucc45\uc774\ub098 \ud65c\ub3d9\uc744 \ub9cc\ub098\uba74 \uc131\uacfc\uac00 \ube60\ub974\uac8c \uc62c\ub77c\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc791\uc740 \uc131\ucde8\uac00 \ub3d9\uae30 \ubd80\uc5ec\ub85c \uc774\uc5b4\uc9c0\uba70, \uafb8\uc900\ud788 \uc774\uc5b4\uac08 \ub54c \uc810\uc9c4\uc801 \ubc1c\uc804\uc744 \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",advancedDesc:"\ud574\ub2f9 \ud559\ub144 \uad50\uacfc\uc11c\ub97c \uc77d\ub294 \ub3c5\uc11c\ubc29\ubc95\uc744 \uac16\ucd94\uace0 \uc788\uc9c0\ub9cc, \uc544\uc9c1\uc740 \ud559\uc2b5\uc5d0 \ub300\ud55c \ud765\ubbf8\uc640 \ub3d9\uae30\uac00 \ubd80\uc871\ud55c \ud3b8\uc785\ub2c8\ub2e4. \ucc45 \uc77d\uae30\ub098 \ud559\uc2b5 \uc804\ubc18\uc5d0\uc11c \uc790\uc2e0\uac10\uc774 \ub5a8\uc5b4\uc838 \uc788\uc5b4, \ud560 \uc218 \uc788\ub294 \ub9cc\ud07c\uc758 \ucd5c\uc18c\ud55c\ub9c