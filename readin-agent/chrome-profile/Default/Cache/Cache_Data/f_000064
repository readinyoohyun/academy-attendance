c00 \uc788\uc744 \uc218 \uc788\uc5b4\uc694.","\ub2e4\uc591\ud55c \uc7a5\ub974\ub85c \ub3c5\uc11c \uc601\uc5ed\uc744 \ud655\uc7a5\ud558\uba74 \ub354\uc6b1 \uade0\ud615\uc7a1\ud78c \uc131\uc7a5\uc744 \uc774\ub8f0 \uc218 \uc788\uc744 \uac70\uc608\uc694."],url:"/assets/images/prsv2/ui/step/new_step4.svg"},{stepId:11,title:"\uade0\ud615 \ubc1c\ub2ec\ud615",newTitle:"\uc5b4\ub514\uc11c\ub098 \ud658\uc601\ubc1b\ub294 \uc62c\ub77c\uc6b4\ub354",word:["\uce58\uc6b0\uce68 \uc5c6\ub294 \ubc38\ub7f0\uc2a4","\uc548\uc815\uc801\uc778 \ud559\uc2b5 \ud750\ub984","\ud559\uc2b5\uacfc \ub3c5\uc11c\uc5d0\n \uc8fc\ub3c4\uc131 \ud544\uc694","\ub3c4\uc804\uc801\uc778 \ub09c\uc774\ub3c4 \ud544\uc694"],message:["\ub3c5\uc11c\uc774\ud574\ub3c4\uc640 \ub3c5\uc11c\ubc29\ubc95\uc774 \uade0\ud615 \uc788\uac8c \ubc1c\ub2ec\ud574 \uc788\uc5b4\uc694.","\ub300\ubd80\ubd84\uc758 \ud14d\uc2a4\ud2b8\ub97c \ubb34\ub9ac \uc5c6\uc774 \uc18c\ud654\ud574\ub0bc \uc218 \uc788\uc5b4\uc694.","\uc548\uc815\uc801\uc778 \ud559\uc2b5 \ud750\ub984\uc744 \uc720\uc9c0\ud558\uace0 \uc788\uad70\uc694.","\ucc45\uc758 \ub09c\uc774\ub3c4\ub97c \ub192\uc5ec \ub3c4\uc804\ud558\uba74 \ub354\uc6b1 \uc131\uc7a5\ud560 \uc218 \uc788\uc744 \uac70\uc608\uc694."],url:"/assets/images/prsv2/ui/step/new_step5.svg"},{stepId:10,title:"\uc9c0\uc2dd \uc911\uc2ec\ud615",newTitle:"\uae30\uc5b5\ub825 \uc88b\uc740 \uc554\uae30\uc655",word:["\ub2e8\ud3b8\uc801 \uc9c0\uc2dd,\n \uc694\uc57d \uc815\ubcf4 \uc120\ud638","\ub6f0\uc5b4\ub09c \uae30\uc5b5\ub825","\uc131\uc2e4\ud55c \ud559\uc2b5 \ud0dc\ub3c4","\ube44\ud310\uc801 \uc0ac\uace0 \ubd80\uc871"],message:["\uc0ac\uc2e4\uc801 \uc774\ud574\uc5d0 \uac15\uc810\uc744 \ubcf4\uc5ec\uc694.","\ub9e1\uc740 \uacfc\uc81c\ub294 \ucda9\uc2e4\ud558\uac8c \ud574\ub0b4\ub294 \uc2a4\ud0c0\uc77c\uc774\uc5d0\uc694.","\uc131\uc2e4\ud568\uacfc \uafb8\uc900\ud568\uc774 \ub3cb\ubcf4\uc774\ub294\uad70\uc694.","\ub3c5\uc11c\ubc29\ubc95\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uba74 \ub2e8\uc21c \uc554\uae30\ub97c \ub118\uc5b4, \uae4a\uc740 \uc774\ud574\ub85c \ub098\uc544\uac08 \uc218 \uc788\uc744 \uac70\uc608\uc694."],url:"/assets/images/prsv2/ui/step/new_step6.svg"},{stepId:9,title:"\ubc1c\uc804 \uc9c4\ud589\ud615",newTitle:"\uc8fc\uad00 \ub69c\ub837\ud55c \uc2e4\ucc9c\uac00",word:["\uc589\uace0 \ub113\uc740 \ub3c5\uc11c \uacbd\ud5d8","\uc774\ud574\ud558\uace0 \uc801\uc6a9\ud558\uae30","\ucde8\ubbf8 \ub3c5\uc11c \uc911\uc2ec","\ubc30\uc6c0\uc744 \uc704\ud55c \ubaa9\uc801 \uc788\ub294\n \ub3c5\uc11c \ud544\uc694"],message:["\ub3c5\uc11c \ubc0f \ud559\uc2b5 \ubc29\ubc95\uc744 \uc54c\uace0, \ubc1c\uc804\ud558\ub294 \uacfc\uc815\uc5d0 \uc788\uc5b4\uc694.","\uc54c\uace0 \uc788\ub294 \ubc29\ubc95\uc744 \uc2e4\uc81c \uc774\ud574\ub85c \uc5f0\uacb0\ud558\uae30 \uc5b4\ub824\uc6b8 \ub54c\uac00 \uc788\uc744 \uac70\uc608\uc694.","\ucc45\uc744 \uc88b\uc544\ud558\uba70 \ub3c5\uc11c \uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud3b8\uc774\uc5d0\uc694.","\ubc30\uc6b4 \uc804\ub7b5\uc744 \uc2e4\ucc9c\uc73c\ub85c \uc62e\uaca8 \ubcf8\ub2e4\uba74 \ub354 \ud070 \uc131\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uc5b4\uc694."],url:"/assets/images/prsv2/ui/step/new_step7.svg"},{stepId:8,title:"\ud3c9\uade0 \uc131\uc2e4\ud615",newTitle:"\ubb35\ubb35\ud788 \uac77\ub294 \uc131\uc2e4\ud30c",word:["\ubcc0\ud568\uc5c6\ub294 \uc131\uc2e4\ud568","\uc548\uc815\uc801\uc778 \ud559\uc2b5 \ub8e8\ud2f4","\uc218\ub3d9\uc801\uc778 \uc758\ubb34\uac10","\ub0b4\uc801 \ub3d9\uae30 \ucc3e\uae30"],message:["\uc131\uc2e4\ud55c \ud0dc\ub3c4\ub97c \ubc14\ud0d5\uc73c\ub85c \uae30\ubcf8\uae30\ub97c \uc798 \uc720\uc9c0\ud558\uace0 \uc788\uc5b4\uc694.","\ub2e8\uc21c \uc694\uc57d \uc911\uc2ec\uc758 \uc77d\uae30\ub97c \ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc544\uc694.","\ub3c5\uc11c\uc640 \ud559\uc2b5\uc5d0 \ud765\ubbf8\ub97c \uc870\uae08 \ub354\ud574\uc8fc\uba74, \ud55c \ub2e8\uacc4 \ub192\uc740 \uc131\ucde8\ub97c \uae30\ub300\ud560 \uc218 \uc788\uc744 \uac70\uc608\uc694."],url:"/assets/images/prsv2/ui/step/new_step8.svg"},{stepId:7,title:"\ud5a5\uc0c1 \ud544\uc694\ud615",newTitle:"\ub2e4\ub4ec\uc5b4\uc9c0\uc9c0 \uc54a\uc740 \uc6d0\uc11d",word:["\uc21c\uc218\ud558\uace0 \uc131\uc2e4\ud55c \ud0dc\ub3c4","\ub178\ub825\ud558\ub824\ub294 \uc790\uc138","\ub178\ub825 \ub300\ube44 \uc131\uacfc \ub0ae\uc74c","\uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc\n \uc791\uc740 \uc131\ucde8 \ud544\uc694"],message:["\ud3c9\uade0\uc801\uc778 \uc774\ud574\ub3c4\uc640 \uc131\uacfc\ub97c \ubcf4\uc774\uace0 \uc788\uc5b4\uc694.","\ub178\ub825\uc744 \ud1b5\ud574 \uc131\uc7a5\ud560 \uc218 \uc788\ub294 '\uc7a0\uc7ac\ub825'\uc774 \ubcf4\uc5ec\uc694.","\uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc791\uc740 \uc131\ucde8\ub85c \ud070 \ubcc0\ud654\ub97c \uc774\ub04c\uc5b4 \ub0bc \uc218 \uc788\uc744 \uac70\uc608\uc694."],url:"/assets/images/prsv2/ui/step/new_step9.svg"},{stepId:6,title:"\uc804\ub7b5 \ubd88\uade0\ud615\ud615",newTitle:"\ub0b4\uc2e4\uc774 \ud544\uc694\ud55c \ud65c\ub3d9\uac00",word:["\uac89\ud565\uae30\uc2dd \uc77d\uae30","\uc774\ud574\ubcf4\ub2e4 \ud45c\ud604 \uc911\uc2ec","\ube44\ubb38\ud559 \uc815\ub3c5 \ud6c8\ub828","\uae4a\uc774 \ud30c\uace0\ub4dc\ub294\n \ub048\uae30 \ud544\uc694"],message:["\uc790\ubc1c\uc801 \ub3c5\uc11c\ub97c \ud558\ub294 \uac83\ucc98\ub7fc \ubcf4\uc774\ub098 \uc2e4\uc81c\ub85c\ub294 \uc798 \uc774\ud574\ud558\uc9c0 \ubabb\ud560 \uc218 \uc788\uc5b4\uc694.","\ud2b9\ud788 \ube44\ubb38\ud559 \uc7a5\ub974\uc5d0\uc11c \uc5b4\ub824\uc6c0\uc744 \ub290\ub07c\uae30\ub3c4 \ud574\uc694.","\ud65c\ubc1c\ud55c \uc131\ud5a5\uc744 \ud1a0\ub860\uc774\ub098 \ud611\ub825 \ud559\uc2b5\uc5d0 \ud65c\uc6a9\ud574 \ubcf4\uc138\uc694.","\uae00\uc758 \uc758\ubbf8\ub97c \uae4a\uac8c \ud30c\uc545\ud558\ub294 \ud6c8\ub828\uc744 \ud1b5\ud574 \ud559\uc2b5 \ud6a8\uacfc\ub97c \ub192\uc77c \uc218 \uc788\uc5b4\uc694."],url:"/assets/images/prsv2/ui/step/new_step10.svg"},{stepId:5,title:"\ub3d9\uae30 \ubd80\uc871\ud615",newTitle:"\uc7a0\uc7ac\ub825\ub9cc \ubbff\ub294 \ubca0\uc9f1\uc774",word:["\uadc0\ucc28\ub2c8\uc998\uacfc \uc694\ub839","\ucd5c\uc18c\ud5